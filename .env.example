NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

DB_HOST=your-instance
DB_PORT=your-port
DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=
DB_SSL_CA_PATH=C:/certificados/mx-central-1-bundle.pem
SESSION_TTL_SECONDS=604800

# Pilot settings; adapters must enforce these before enabling sources.
EXTERNAL_SOURCES_ENABLED=false
EXTERNAL_REQUEST_TIMEOUT_MS=10000
EXTERNAL_EVALUATION_BUDGET_MS=45000
EXTERNAL_MAX_CONCURRENT_REQUESTS=1
EXTERNAL_MAX_QUEUED_REQUESTS=8
NVD_MIN_INTERVAL_MS=10000
NVD_MAX_RESPONSE_BYTES=2097152
NVD_PAGE_SIZE=50
NVD_MAX_PAGES=2
KEV_MAX_RESPONSE_BYTES=5242880
EXTERNAL_CACHE_TTL_SECONDS=3600
EXTERNAL_CACHE_MAX_ENTRIES=50
EXTERNAL_CACHE_MAX_BYTES=8388608
NVD_API_KEY=

